# Copy to .env. Never commit the real file.

# --- Polymarket wallet (leave empty to stay in paper mode) ------------------------
PRIVATE_KEY=
WALLET_ADDRESS=
POLYMARKET_PROXY_ADDRESS=
# Only if you keep an encrypted env file (see decrypt_keys.py)
MASTER_PASSWORD=

# --- Dashboard ---------------------------------------------------------------------
FLASK_SECRET_KEY=
# Binds to localhost by default. Only set 0.0.0.0 if you also set BOT_API_TOKEN.
BOT_HOST=127.0.0.1
# Required for state-changing requests from other machines or through any proxy/tunnel.
# Send as X-API-Token header or ?token=
BOT_API_TOKEN=

# --- Integrations (optional) -------------------------------------------------------
ANTHROPIC_API_KEY=
TG_BOT_TOKEN=
TG_CHAT_ID=
